# ---- 凭证 / 密钥（绝不入库）----
amap_key.txt
amap_security.txt
token.txt
icp.txt
media_base.txt
*.pem
*.key
*.crt
*.csr
.env
.env.*

# ---- 证书签发工具与私钥 ----
# acme/ 里有 TLS 私钥、Let's Encrypt 账户私钥，还有 64MB 的 lego 二进制
acme/

# ---- 用户数据（含密码哈希、行程、照片）----
data.db
data.db-journal
data.db-wal
data.db-shm
uploads/

# ---- 演示素材池（只在发布时用到，不进库）----
# assets/demo-media/ 是 fetch_demo_assets.py 从 Wikimedia 抓来的 31MB 图片视频。
# 它只被 publish_demo_assets.py 用一次（发布到 OSS），之后 seed 完全不需要它。
# 生产机上根本不用有这个目录，所以没必要让每个 clone 都背着它。
assets/demo-media/

# ---- 宣传片素材工作区 ----
# 录屏、配音、下载的 CC0 音乐、中间产物，加起来几十 MB，而且全都能由
# scripts/record_promo_footage.py + scripts/build_promo_video.py 重新生成。
# 成片本身发布在 OSS 的 uploads/promo/ 下，也不需要进库。
build/

# ---- 运行时产物 ----
logs/
*.log
backups/
ops/.alert-state/
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db
*.swp
*~

# ---- 开发过程留下的源码快照 ----
*.bak
*.bak-*
*.orig

# ---- Agent / 本机运维专用，不属于项目本体 ----
# 这些是把代码和数据同步到另一台机器、发飞书告警、切域名之类的私有基建脚本，
# 里面是特定机器的路径和主机名，对别人没有意义。文件仍留在本地磁盘上。
ops/*
# sync-oss.sh 是例外：它是媒体分发链路的一部分（媒体绕开 frp 隧道全靠它），
# 热备机和别人的 clone 都要能跑，不该只活在这一台机器的磁盘上。
# 注意这里必须写成 `ops/*` 而不是 `ops/` —— git 的规则是父目录被忽略之后，
# 里面的文件再怎么否定都恢复不回来。
!ops/sync-oss.sh
!ops/oss_referenced_names.py

backup.sh
switch-to-domain.sh
sync-to-top001.sh
set-icp.sh
TRAVEL-MEMORY-HANDOFF.md
*.deprecated-*

# ossutil（媒体同步到对象存储）的运行日志，机器本地产物
ossutil_output/

# 宣传片的预览副本：挂在 static/ 下只是为了能用浏览器点开看，成片发布走 OSS。
# 里面有 8MB 的 mp4，不该进库；文本那几份在 scripts/ 下有入库的正本。
static/promo/

# 宣传策划文档里的成片：只留文档和分镜图，mp4 不进库。
# 4 个片子共 109MB（50s 脚本版 37M / 50s 42M / 45s 23M / 15s 竖版 7.2M），
# 收进来会让 .git 从 10MB 涨到 120MB 且永久留在历史里；线上 OSS 已有同一份。
# 跟上面 static/promo/ 一个道理。
docs/advertising/assets/*.mp4
